<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  apple-terminal syntax theme for bat, and through bat's theme cache, for delta.
  Same palette as ghostty/config, which takes its values from Terminal.app's
  Clear Dark profile. Structure is bright white, literals are yellow, types
  and functions are cyan, comments and punctuation are gray. Green is absent on
  purpose: it only ever means "ok" or "added", which here is the diff scopes.
-->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>apple-terminal</string>
  <key>uuid</key>
  <string>3c1b7f42-9a6d-4e58-b0c7-2d5f8a1e6b94</string>
  <key>colorSpaceName</key>
  <string>sRGB</string>
  <key>semanticClass</key>
  <string>theme.dark.apple_terminal</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>#000000</string>
        <key>foreground</key>
        <string>#E0E0E0</string>
        <key>caret</key>
        <string>#E5C872</string>
        <key>lineHighlight</key>
        <string>#191D27</string>
        <key>selection</key>
        <string>#273D4C</string>
        <key>gutter</key>
        <string>#000000</string>
        <key>gutterForeground</key>
        <string>#465C6D</string>
        <key>invisibles</key>
        <string>#273D4C</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Comment</string>
      <key>scope</key>
      <string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#465C6D</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Keyword and storage</string>
      <key>scope</key>
      <string>keyword, keyword.control, keyword.other, storage, storage.modifier, keyword.declaration</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#E5EFF5</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Operator and punctuation</string>
      <key>scope</key>
      <string>keyword.operator, punctuation, meta.brace, punctuation.separator, punctuation.terminator, punctuation.section</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#A9B5BF</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>String</string>
      <key>scope</key>
      <string>string, string.quoted, string.template, punctuation.definition.string</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#C4AC62</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Number, constant, escape</string>
      <key>scope</key>
      <string>constant.numeric, constant.language, constant.character, constant.character.escape, constant.other</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#E5C872</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Function</string>
      <key>scope</key>
      <string>entity.name.function, support.function, meta.function-call, variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#84DDE0</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Type and class</string>
      <key>scope</key>
      <string>entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.name.namespace, storage.type, support.type, support.class, entity.other.inherited-class</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#7CCBCD</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Variable and parameter</string>
      <key>scope</key>
      <string>variable, variable.other, variable.parameter, meta.definition.variable, support.variable</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#E0E0E0</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Tag and attribute</string>
      <key>scope</key>
      <string>entity.name.tag, punctuation.definition.tag</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#E5EFF5</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Attribute name and key</string>
      <key>scope</key>
      <string>entity.other.attribute-name, support.type.property-name, meta.object-literal.key</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#7CCBCD</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Invalid</string>
      <key>scope</key>
      <string>invalid, invalid.illegal, invalid.deprecated</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#B45648</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Markup heading and bold</string>
      <key>scope</key>
      <string>markup.heading, markup.bold</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#E5EFF5</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Markup link and quote</string>
      <key>scope</key>
      <string>markup.underline.link, string.other.link, markup.quote</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#84DDE0</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Diff inserted</string>
      <key>scope</key>
      <string>markup.inserted, meta.diff.header.to-file</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#6CAA71</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Diff deleted</string>
      <key>scope</key>
      <string>markup.deleted, meta.diff.header.from-file</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#B45648</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Diff changed and range</string>
      <key>scope</key>
      <string>markup.changed, meta.diff.range</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#E5C872</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Diff header</string>
      <key>scope</key>
      <string>meta.diff, meta.diff.header</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#A9B5BF</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
