# Ghostty config: https://ghostty.org/docs/config/reference
# Symlinked live into ~/.config/ghostty/config via nix-darwin/modules/home/ghostty.nix
# Read by libghostty inside cmux, so this file is the single source of truth for
# the terminal palette. Every terminal tool below inherits it through ANSI.
#
# Colors are Ghostty's stock palette. The only deviation is the background,
# which is true black instead of Ghostty's #282c34.
#
# No `theme =` line: any theme directive suppresses cmux's own managed palette,
# so both apps stay on their defaults.

background = #000000

cursor-style = block
cursor-style-blink = false

font-family = JetBrainsMono Nerd Font
font-size = 14

window-padding-x = 8
window-padding-y = 6
window-decoration = true

# Keep window chrome on the palette instead of the macOS accent color.
window-theme = ghostty

# Dim the inactive half of a split so focus reads without a colored border.
unfocused-split-opacity = 0.8

mouse-hide-while-typing = true

macos-titlebar-style = tabs
