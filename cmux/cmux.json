{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "paneBorderColor": "#35424C",
  "activePaneBorderColor": "#E5EFF5",
  "app": {
    "appearance": "dark"
  },
  "terminal": {
    "adaptiveDefaultTheme": false,
    "showScrollBar": false
  },
  "sidebarAppearance": {
    "matchTerminalBackground": true,
    "tintColor": "#000000",
    "tintOpacity": 0
  },
  "workspaceColors": {
    "selectionColor": "#273D4C",
    "notificationBadgeColor": "#E5C872",
    "colors": {
      "Red": "#B45648",
      "Yellow": "#C4AC62",
      "Green": "#6CAA71",
      "Cyan": "#7CCBCD",
      "Blue": "#6D96B4",
      "Magenta": "#BD7BCD",
      "Bone": "#DEE5EB",
      "Slate": "#465C6D"
    }
  },
  "notifications": {
    "paneFlashColor": "#E5C872"
  },
  "shortcuts": {
    "bindings": {
      "saveFilePreview": {
        "first": {
          "command": false,
          "control": false,
          "key": "",
          "option": false,
          "shift": false
        }
      },
      "toggleSidebar": {
        "first": {
          "command": true,
          "control": false,
          "key": "s",
          "keyCode": 1,
          "option": false,
          "shift": false
        }
      }
    }
  }
}
