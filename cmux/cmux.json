{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "appearance": "dark"
  },
  "terminal": {
    "showScrollBar": false
  },
  "sidebarAppearance": {
    "matchTerminalBackground": true
  },
  "shortcuts": {
    "bindings": {
      "saveFilePreview": {
        "first": {
          "command": false,
          "control": false,
          "key": "",
          "option": false,
          "shift": false
        }
      },
      "toggleSidebar": {
        "first": {
          "command": true,
          "control": false,
          "key": "s",
          "keyCode": 1,
          "option": false,
          "shift": false
        }
      }
    }
  }
}
