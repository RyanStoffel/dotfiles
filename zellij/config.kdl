// ~/.config/zellij/config.kdl
//
// Monochrome and low-chrome. Stock zellij ships a two-row status bar of
// keybinding hints plus powerline pill separators; both are off below.
// Keybindings are left entirely at upstream defaults.

// Requested: mouse support. Click panes and tabs, drag borders, scroll.
mouse_mode true

// Drop the powerline arrow and pill separators in favor of plain text.
simplified_ui true

// No frames drawn around panes. Reclaims a row and a column per pane.
pane_frames false

// Stock "default" layout is tab-bar + panes + a full status-bar ribbon of key
// hints. "compact" is panes + a single tab line, which is two fewer rows of
// chrome and far less copy on screen.
default_layout "compact"

// No release-notes pane on version bumps.
show_release_notes false

theme "apple-terminal"

themes {
    // apple-terminal, shared with ghostty/config, which takes its values from
    // Terminal.app's Clear Dark profile. Apple's blue-gray neutrals carry the
    // chrome so the UI sits quietly on true black; red, green and yellow stay
    // legible because zellij uses them for real state.
    apple-terminal {
        fg 224 224 224
        bg 0 0 0
        black 53 66 76
        white 229 239 245
        red 180 86 72
        green 108 170 113
        yellow 196 172 98
        blue 109 150 180
        magenta 189 123 205
        orange 229 200 114
        cyan 124 203 205
    }
}
